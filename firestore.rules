rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Профиль — только владелец
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Мероприятия: читают все вошедшие, меняет только организатор.
    // Участник может изменить только счётчик "registered".
    match /events/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.organizerId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.organizerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registered'])
      );
      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;
    }

    // Регистрации (билеты): видят владелец-участник и организатор мероприятия
    match /registrations/{id} {
      allow read: if signedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        resource.data.organizerId == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.organizerId == request.auth.uid;
      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.organizerId == request.auth.uid
      );
    }
  }
}
